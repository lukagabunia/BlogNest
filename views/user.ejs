<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--Links-->
    <link rel="stylesheet" href="../Styles/style.css" />
    <link rel="stylesheet" href="../Styles/responsive.css" />
    <link rel="stylesheet" href="../Styles/user.css" />
    <link rel="stylesheet" href="../Styles/dark-theme.css" />
    <!--Icons-->
    <link rel="icon" href="/Assets/Icons/mug-hot-solid.ico" />
    <link
      rel="icon"
      type="image/xml+svg"
      href="/Assets/Icons/mug-hot-solid.svg"
    />
    <!--js-->
    <script src="../js/app.js" defer></script>
    <script src="../js/user.js" defer></script>
    <!--jquery-->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <title>User profile</title>
  </head>
  <body>
    <%- include('partials/header.ejs') %>
    <div class="container body-container">
      <div class="user-main-container">
        <section id="user-profile">
          <div class="user-portfolio">
            <img src="../Assets/Img/user-solid.svg" alt="" />
            <div class="change-image">
              <label for="file">Change image</label>
              <input type="file" id="file" />
              <button class="save-btn">Save</button>
            </div>
          </div>
        </section>
        <section id="user-info">
          <div class="user-bio">
            <h2>Welcome, <span class="user-fullName"></span>!</h2>
            <p>
              <strong>Username: </strong><span class="user-username"></span>
              <button class="edit-btn">Edit</button>
              <button class="cancel-btn">Cancel</button>
            </p>
            <div class="edit-container">
              <input type="text" class="edit-input" />
              <button class="save-btn">Save</button>
            </div>
            <p>
              <strong>Email: </strong><span class="user-email"></span>
              <button class="edit-btn">Edit</button>
              <button class="cancel-btn">Cancel</button>
            </p>
            <div class="edit-container">
              <input type="email" class="edit-input" />
              <button class="save-btn">Save</button>
            </div>
            <p><strong>Sex: </strong><span class="user-sex"></span></p>
            <div class="user-buttons">
              <button class="my-posts"><a href="#">My posts</a></button>
              <button class="create-post">
                <a href="./create-post.html">Create a post</a>
              </button>
            </div>
          </div>
        </section>
      </div>
    </div>
    <%- include('partials/footer.ejs') %>
  </body>
</html>
