<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--Links-->
    <link rel="stylesheet" href="../Styles/style.css" />
    <link rel="stylesheet" href="../Styles/signup.css" />
    <link rel="stylesheet" href="../Styles/responsive.css" />
    <link rel="stylesheet" href="../Styles/dark-theme.css" />
    <!--Icons-->
    <link rel="icon" href="/Assets/Icons/mug-hot-solid.ico" />
    <link
      rel="icon"
      type="image/xml+svg"
      href="/Assets/Icons/mug-hot-solid.svg"
    />
    <!--js-->
    <script src="../js/app.js" defer></script>
    <script src="../js/signup.js" defer></script>
    <!--jquery-->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <title>Sign up</title>
  </head>
  <body>
    <%- include('partials/header.ejs') %>
    <div class="container body-container">
      <section id="signup">
        <div class="reg-container">
          <h1>Sign up</h1>
          <form action="/signup/submit" method="post">
            <div>
              <label for="first-name" class="first-name d-block mb-5"
                >Enter your first name</label
              >
              <input
                id="first-name"
                name="first-name"
                type="text"
                class="signUp-input d-block w-100 mb-10"
                placeholder="First name"
                autocomplete="name"
                required
              />
              <span class="firstname-error"></span>
            </div>
            <div>
              <label for="last-name" class="last-name d-block mb-5"
                >Enter your last name</label
              >
              <input
                id="last-name"
                name="last-name"
                type="text"
                class="signUp-input d-block w-100 mb-10"
                placeholder="Last name"
                required
              />
              <span class="lastname-error"></span>
            </div>
            <div>
              <label for="email" class="d-block mb-5">Enter your email</label>
              <input
                name="email"
                id="email"
                type="email"
                class="signUp-input d-block w-100 mb-10"
                placeholder="Email"
                autocomplete="email"
                required
              />
            </div>
            <div>
              <label for="con-email" class="d-block mb-5"
                >Confirm your email</label
              >
              <input
                id="con-email"
                name="con-email"
                type="email"
                class="signUp-input d-block w-100 mb-10"
                placeholder="Confirm your email"
                autocomplete="off"
                required
              />
              <span class="con-email-error"></span>
            </div>
            <label for="gender" class="d-block mb-10">Select your gender</label>
            <div class="gender mb-10" id="gender">
              <input
                id="male"
                name="gender"
                type="radio"
                class="signUp-input-gender"
                autocomplete="off"
                title="male"
                required
              />
              <label for="gender">Man</label>
              <input
                name="gender"
                id="female"
                type="radio"
                class="signUp-input-gender"
                autocomplete="off"
                title="female"
                required
              />
              <label for="gender">Women</label>
            </div>
            <div>
              <label for="pass" class="d-block mb-5">Enter your password</label>
              <input
                id="pass"
                name="pass"
                type="password"
                class="signUp-input d-block w-100 mb-10"
                placeholder="Password"
                autocomplete="off"
                required
              />
              <span class="error"></span>
            </div>
            <div>
              <label for="con-pass" class="d-block mb-5"
                >Confirm your password</label
              >
              <input
                id="con-pass"
                name="con-pass"
                type="password"
                class="signUp-input d-block w-100 mb-10"
                placeholder="Confirm your password"
                autocomplete="off"
                required
              />
              <span class="con-error"></span>
            </div>
            <div class="d-block mb-10">
              <input id="remember" type="checkbox" />
              <label for="remember">Remember me</label>
            </div>
            <button
              id="signup-btn"
              class="btn btn-reset w-100 mb-10"
              type="submit"
            >
              Sign up
            </button>
          </form>
          <div class="d-block mb-10">
            <p>
              Already have an account?
              <a class="btn btn-link" href="/login">Log in</a>
            </p>
          </div>
        </div>
      </section>
    </div>
    <%- include('partials/footer.ejs') %>
  </body>
</html>
